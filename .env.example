# Copy to .env and fill in. Upload to Supabase with: supabase secrets set --env-file .env
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Any random string (A-Z, a-z, 0-9, _ and -), e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the @
BOT_USERNAME=MathHelperBot
ANTHROPIC_API_KEY=sk-ant-...
# Max solved problems per user per hour
RATE_LIMIT_PER_HOUR=10
# Max solved problems per 24h across all chats (bounds API spend)
DAILY_REQUEST_LIMIT=300
# Comma-separated Telegram user ids of admins who approve/block groups (open a private chat
# with the bot and send /start first, so it can message you). Find your id via @userinfobot.
ADMIN_USER_IDS=
# Give up and tell the user after this many seconds. Keep below the Edge Function
# wall-clock limit: 150s on the free plan, 400s on paid plans.
SOLVE_TIMEOUT_SECONDS=120

# Claude model: claude-haiku-5-5 (cheapest; matched Opus on our 21-problem test),
# claude-sonnet-5-5, or claude-opus-5-5 (default when unset)
CLAUDE_MODEL=claude-haiku-5-5

# Only used by scripts/set-webhook.sh (not needed as a Supabase secret)
SUPABASE_PROJECT_REF=
